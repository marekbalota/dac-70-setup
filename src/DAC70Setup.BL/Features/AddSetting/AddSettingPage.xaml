<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DAC70Setup.BL.Features.AddSetting"
             xmlns:models="clr-namespace:DAC70Setup.BL.Models"
             xmlns:definitions="clr-namespace:DAC70Setup.Core.Models.Definitions;assembly=DAC70Setup.Core"
             xmlns:fontAwesome="clr-namespace:DAC70Setup.BL.Resources"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             xmlns:controls="clr-namespace:DAC70Setup.BL.Controls"
             x:Class="DAC70Setup.BL.Features.AddSetting.AddSettingPage"
             x:DataType="local:AddSettingPageViewModel"
             Title="{localization:Translate AddSettingTitle}">

    <Grid RowDefinitions="Auto,*">
        <controls:ConfigurationContextBar Grid.Row="0" ConfigurationName="{Binding Configuration.Name}">
            <Label Text="{Binding Configuration.Created, StringFormat='{0:d} · {0:t}'}"
                   Style="{StaticResource ContextBarValue}" />
        </controls:ConfigurationContextBar>

        <!-- CollectionView.EmptyView is not rendered while IsGrouped is true,
             so the empty message is a sibling of the list rather than its own. -->
        <VerticalStackLayout Grid.Row="1" Spacing="6" Padding="10" HorizontalOptions="Center" VerticalOptions="Center"
                             IsVisible="{Binding IsEmpty}">
            <Label Text="{x:Static fontAwesome:AwesomeSolidIconFont.CircleCheck}" FontFamily="FA-S" FontSize="34" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceMutedLight}, Dark={StaticResource OnSurfaceMutedDark}}" />
            <Label Text="{localization:Translate NoRemainingSettings}"
                   Style="{StaticResource EmptyStateTitle}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableSettings}" IsGrouped="True" SelectionMode="None"
                        IsVisible="{Binding IsEmpty, Converter={toolkit:InvertedBoolConverter}}">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:SettingDefinitionGroup">
                    <VerticalStackLayout>
                        <Label Text="{Binding Panel}" Style="{StaticResource GroupHeader}" />
                        <BoxView Style="{StaticResource RowDivider}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="definitions:Dac70SettingDefinition">
                    <controls:SettingRow Name="{Binding Name}" ShowChevron="True">
                        <controls:SettingRow.GestureRecognizers>
                            <TapGestureRecognizer
                                    Command="{Binding SelectDefinitionCommand, Source={RelativeSource AncestorType={x:Type local:AddSettingPageViewModel}}}"
                                    CommandParameter="{Binding .}" />
                        </controls:SettingRow.GestureRecognizers>
                    </controls:SettingRow>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
