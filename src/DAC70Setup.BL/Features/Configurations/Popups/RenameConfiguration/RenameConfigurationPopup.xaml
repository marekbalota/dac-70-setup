<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup x:TypeArguments="x:String"
               xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:popups="clr-namespace:DAC70Setup.BL.Features.Configurations.Popups.RenameConfiguration"
               xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
               x:Class="DAC70Setup.BL.Features.Configurations.Popups.RenameConfiguration.RenameConfigurationPopup"
               x:DataType="popups:RenameConfigurationPopupViewModel"
               WidthRequest="340" Padding="20,20,20,16"
               Background="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

    <VerticalStackLayout Spacing="16">
        <Label Text="{localization:Translate RenameConfigurationTitle}" FontFamily="PlexSansSemiBold" FontSize="18"
               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />

        <VerticalStackLayout Spacing="6">
            <Label Text="{localization:Translate RenameConfigurationName}" Style="{StaticResource CardCaption}" />
            <Entry Text="{Binding Name}" ReturnCommand="{Binding RenameCommand}" />
        </VerticalStackLayout>

        <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
            <Button Text="{localization:Translate RenameConfigurationCancel}" Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButton}" StyleClass="DialogButton" />

            <Button Text="{localization:Translate RenameConfigurationAccept}" Command="{Binding RenameCommand}"
                    Style="{StaticResource PrimaryButton}" StyleClass="DialogButton" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</toolkit:Popup>
