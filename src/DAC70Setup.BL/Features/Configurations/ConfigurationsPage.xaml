<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DAC70Setup.BL.Features.Configurations"
             xmlns:models="clr-namespace:DAC70Setup.BL.Models"
             xmlns:fontAwesome="clr-namespace:DAC70Setup.BL.Resources"
             xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:deviceStatus="clr-namespace:DAC70Setup.BL.Controls.DeviceStatus"
             xmlns:controls="clr-namespace:DAC70Setup.BL.Controls"
             x:Class="DAC70Setup.BL.Features.Configurations.ConfigurationsPage"
             x:Name="PageRoot"
             x:DataType="local:ConfigurationsPageViewModel">

    <Shell.TitleView>
        <controls:PageTitleView Title="{localization:Translate ConfigurationsTitle}"
                ConfigurationName="{Binding ConfigurationsService.SelectedConfiguration.Name}" />
    </Shell.TitleView>

    <ContentPage.ToolbarItems>
        <ToolbarItem Order="Primary" Priority="0" Text="{localization:Translate ConfigurationsCreate}" Command="{Binding CreateConfigurationCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FA-S" Size="22" Glyph="{x:Static fontAwesome:AwesomeSolidIconFont.Plus}"
                                 Color="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>

        <ToolbarItem Order="Primary" Priority="1" Text="{localization:Translate ConfigurationsDelete}" Command="{Binding DeleteConfigurationCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="FA-S" Size="22" Glyph="{x:Static fontAwesome:AwesomeSolidIconFont.Trash}"
                                 Color="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <deviceStatus:DeviceStatusBar Status="{Binding DeviceStatus}">
        <CollectionView ItemsSource="{Binding ConfigurationsService.Configurations}" SelectionMode="None">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WidthStates">
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="ItemsLayout">
                                <Setter.Value>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                                </Setter.Value>
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="ItemsLayout">
                                <Setter.Value>
                                    <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="0" HorizontalItemSpacing="0" />
                                </Setter.Value>
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5" Padding="10">
                    <Label Text="{x:Static fontAwesome:AwesomeSolidIconFont.Toolbox}" FontFamily="FA-S" FontSize="34" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceMutedLight}, Dark={StaticResource OnSurfaceMutedDark}}" />
                    <Label Text="{localization:Translate NoExistingConfiguration}"
                           Style="{StaticResource EmptyStateTitle}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Configuration">
                    <ContentView Padding="10,8">
                        <Border x:Name="CardBorder" Style="{StaticResource Card}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background"
                                            Value="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Border.Behaviors>
                                <toolkit:TouchBehavior LongPressDuration="500"
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenConfigurationCommand}"
                                        CommandParameter="{Binding Source={x:Reference CardBorder}, Path=BindingContext}"
                                        LongPressCommand="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ToggleSelectionCommand}"
                                        LongPressCommandParameter="{Binding Source={x:Reference CardBorder}, Path=BindingContext}" />
                            </Border.Behaviors>

                            <Grid ColumnDefinitions="4,*">
                                <BoxView Grid.Column="0" IsVisible="{Binding IsActive}"
                                         Color="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />

                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11"
                                      Padding="{OnIdiom Phone=13, Default=13, Desktop=11}">
                                    <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10" VerticalOptions="Start"
                                            Background="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background"
                                                        Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Label Text="{x:Static fontAwesome:AwesomeSolidIconFont.Sliders}" FontFamily="FA-S" FontSize="15"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Start">
                                        <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                        <Label Text="{localization:TranslateBinding Settings.Count, TranslateFormat=SettingsCount, TranslateOne=SettingsCountOne}"
                                               Style="{StaticResource CardCaption}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Start">
                                        <Label Text="{Binding Created, StringFormat='{0:d}'}" Style="{StaticResource Timestamp}"
                                               HorizontalTextAlignment="End" />
                                        <Label Text="{Binding Created, StringFormat='{0:t}'}" Style="{StaticResource Timestamp}"
                                               HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </deviceStatus:DeviceStatusBar>
</ContentPage>