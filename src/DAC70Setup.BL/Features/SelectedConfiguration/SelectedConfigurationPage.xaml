<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DAC70Setup.BL.Features.SelectedConfiguration"
             xmlns:fontAwesome="clr-namespace:DAC70Setup.BL.Resources"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             xmlns:controls="clr-namespace:DAC70Setup.BL.Controls"
             x:Class="DAC70Setup.BL.Features.SelectedConfiguration.SelectedConfigurationPage"
             x:DataType="local:SelectedConfigurationPageViewModel"
             Title="{localization:Translate SelectedConfigurationTitle}">

    <ContentPage.IconImageSource>
        <FontImageSource FontFamily="FA-S" Glyph="{x:Static fontAwesome:AwesomeSolidIconFont.Share}"/>
    </ContentPage.IconImageSource>

    <Grid>
        <controls:NoConfigurationSelectedView GoToConfigurationsCommand="{Binding GoToConfigurationsCommand}"
                DownloadFromDeviceCommand="{Binding DownloadFromDeviceCommand}"
                IsVisible="{Binding Model.SelectedConfiguration, Converter={toolkit:IsNullConverter}}" />

        <Grid RowDefinitions="Auto,*" IsVisible="{Binding Model.SelectedConfiguration, Converter={toolkit:IsNotNullConverter}}">
            <controls:ConfigurationContextBar Grid.Row="0" ConfigurationName="{Binding Model.SelectedConfiguration.Name}">
                <Label Text="{Binding Model.SelectedConfiguration.Created, StringFormat='{0:d} · {0:t}'}"
                       Style="{StaticResource ContextBarValue}" />
            </controls:ConfigurationContextBar>

            <VerticalStackLayout Grid.Row="1" Spacing="12" Padding="15,18">
                <Button Text="{localization:Translate SendToDevice}" Command="{Binding SendToDeviceCommand}"
                        Style="{StaticResource PrimaryButton}" ContentLayout="Left,10">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FA-S" Size="15" Glyph="{x:Static fontAwesome:AwesomeSolidIconFont.ArrowUpFromBracket}"
                                         Color="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                    </Button.ImageSource>
                </Button>

                <Button Text="{localization:Translate ExportToFile}" Command="{Binding ExportConfigurationCommand}"
                        Style="{StaticResource SecondaryButton}" ContentLayout="Left,10">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FA-S" Size="15" Glyph="{x:Static fontAwesome:AwesomeSolidIconFont.FileExport}"
                                         Color="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                    </Button.ImageSource>
                </Button>

                <BoxView HeightRequest="1" Margin="0,6"
                         Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />

                <Button Text="{localization:Translate DownloadFromDevice}" Command="{Binding DownloadFromDeviceCommand}"
                        Style="{StaticResource SecondaryButton}" ContentLayout="Left,10">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FA-S" Size="15" Glyph="{x:Static fontAwesome:AwesomeSolidIconFont.Download}"
                                         Color="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                    </Button.ImageSource>
                </Button>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
