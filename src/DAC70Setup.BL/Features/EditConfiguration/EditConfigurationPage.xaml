<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DAC70Setup.BL.Features.EditConfiguration"
             xmlns:models="clr-namespace:DAC70Setup.BL.Models"
             xmlns:values="clr-namespace:DAC70Setup.Core.Models.Values;assembly=DAC70Setup.Core"
             xmlns:fontAwesome="clr-namespace:DAC70Setup.BL.Resources"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             x:Class="DAC70Setup.BL.Features.EditConfiguration.EditConfigurationPage"
             x:DataType="local:EditConfigurationPageViewModel"
             Title="{localization:Translate EditConfigurationTitle}">

    <ContentPage.IconImageSource>
        <FontImageSource FontFamily="FA-S" Glyph="{x:Static fontAwesome:AwesomeSolidIconFont.Gear}"/>
    </ContentPage.IconImageSource>

    <Grid>
        <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20"
                     IsVisible="{Binding Model.SelectedConfiguration, Converter={toolkit:IsNullConverter}}">
            <Label Text="{localization:Translate NoConfigurationSelected}" HorizontalOptions="Center"/>
            <Button Text="{localization:Translate GoToConfigurations}" Command="{Binding GoToConfigurationsCommand}"/>
        </StackLayout>

        <Grid RowDefinitions="Auto,*" Margin="20" RowSpacing="10"
              IsVisible="{Binding Model.SelectedConfiguration, Converter={toolkit:IsNotNullConverter}}">
            <StackLayout Grid.Row="0" Spacing="10">
                <Label Text="{Binding Model.SelectedConfiguration.Name}" FontSize="Title"/>
                <Label Text="{Binding Model.SelectedConfiguration.DateCreatedText}"/>
            </StackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding SettingGroups}" SelectedItems="{Binding SelectedSettings}"
                            SelectionMode="Multiple" IsGrouped="True">
                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="{localization:Translate NoSettingsInConfiguration}"/>
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="models:SettingValueGroup">
                        <Label Text="{Binding Panel}" FontAttributes="Bold" Margin="0,10,0,0"/>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="values:Dac70SettingValue">
                        <Border Margin="0,5">
                            <Grid RowDefinitions="*,*" Margin="10">
                                <Label Grid.Row="0" Text="{Binding Definition.Name}"/>
                                <Label Grid.Row="1" Text="{Binding DisplayValueText}" FontSize="Caption"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
