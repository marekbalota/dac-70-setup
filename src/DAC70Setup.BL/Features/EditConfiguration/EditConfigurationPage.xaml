<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DAC70Setup.BL.Features.EditConfiguration"
             xmlns:fontAwesome="clr-namespace:DAC70Setup.BL.Resources"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             xmlns:controls="clr-namespace:DAC70Setup.BL.Controls"
             xmlns:selection="clr-namespace:DAC70Setup.BL.Features.EditConfiguration.Controls"
             xmlns:values="clr-namespace:DAC70Setup.Core.Models.Values;assembly=DAC70Setup.Core"
             x:Class="DAC70Setup.BL.Features.EditConfiguration.EditConfigurationPage"
             x:DataType="local:EditConfigurationPageViewModel"
             Title="{localization:Translate EditConfigurationTitle}">

    <ContentPage.IconImageSource>
        <FontImageSource FontFamily="FA-S" Glyph="{x:Static fontAwesome:AwesomeSolidIconFont.Gear}"/>
    </ContentPage.IconImageSource>

    <Grid>
        <controls:NoConfigurationSelectedView GoToConfigurationsCommand="{Binding GoToConfigurationsCommand}"
                DownloadFromDeviceCommand="{Binding DownloadFromDeviceCommand}"
                IsVisible="{Binding Model.SelectedConfiguration, Converter={toolkit:IsNullConverter}}" />

        <Grid RowDefinitions="Auto,*" IsVisible="{Binding Model.SelectedConfiguration, Converter={toolkit:IsNotNullConverter}}">
            <controls:ConfigurationContextBar Grid.Row="0" ConfigurationName="{Binding Model.SelectedConfiguration.Name}">
                <Label Text="{Binding Model.SelectedConfiguration.Created, StringFormat='{0:d} · {0:t}'}"
                       Style="{StaticResource ContextBarValue}" />
            </controls:ConfigurationContextBar>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Settings}" IsGrouped="True" SelectionMode="None" Margin="0,4,0,0">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="selection:SettingValueGroup">
                        <VerticalStackLayout>
                            <Label Text="{Binding Panel}" Style="{StaticResource GroupHeader}" />
                            <BoxView Style="{StaticResource RowDivider}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="values:Dac70SettingValue">
                        <controls:SettingRow Name="{Binding Definition.Name}" Value="{Binding DisplayValueText}">
                            <controls:SettingRow.GestureRecognizers>
                                <TapGestureRecognizer
                                        Command="{Binding OpenSettingCommand, Source={RelativeSource AncestorType={x:Type local:EditConfigurationPageViewModel}}}"
                                        CommandParameter="{Binding .}" />
                            </controls:SettingRow.GestureRecognizers>
                        </controls:SettingRow>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
