<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:models="clr-namespace:DAC70Setup.BL.Models"
            xmlns:local="clr-namespace:DAC70Setup.BL.Features.Main"
            xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
            x:Class="DAC70Setup.BL.Features.Main.MainPage"
            x:DataType="local:MainPageViewModel"
            Title="MainPage">
    <FlyoutPage.Flyout>
        <ContentPage Title="Menu" x:Name="FlyoutRoot">
            <Grid RowDefinitions="Auto,*">
                <VerticalStackLayout Grid.Row="0" Padding="20,26,20,18"
                                     Background="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}">
                    <Label Text="DAC-70 Setup" Style="{StaticResource PageTitle}" />
                </VerticalStackLayout>

                <CollectionView Grid.Row="1" ItemsSource="{Binding NavigationItems, Mode=OneTime}"
                                SelectionMode="None" Margin="8,10">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="3" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:FlyoutNavigationItem">
                            <ContentView x:Name="FlyoutItem" Padding="0,11,12,11">
                                <ContentView.GestureRecognizers>
                                    <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference FlyoutRoot}, Path=BindingContext.NavigateCommand}"
                                            CommandParameter="{Binding Source={x:Reference FlyoutItem}, Path=BindingContext}" />
                                </ContentView.GestureRecognizers>

                                <Grid ColumnDefinitions="3,Auto,*">
                                    <BoxView Grid.Column="0" WidthRequest="3" HeightRequest="22" CornerRadius="2" HorizontalOptions="Start"
                                             VerticalOptions="Center" IsVisible="{Binding IsCurrent}"
                                             Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />

                                    <Label Grid.Column="1" FontFamily="FA-S" FontSize="17" WidthRequest="24"
                                           Margin="9,0,0,0" Text="{Binding Icon, Mode=OneTime}"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <VerticalStackLayout Grid.Column="2" Spacing="1" Margin="12,0,0,0">
                                        <Label Text="{localization:TranslateBinding NameKey, TranslateValue=True}"
                                               Style="{StaticResource CardTitle}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="TextColor"
                                                            Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{localization:TranslateBinding DescriptionKey, TranslateValue=True}"
                                               Style="{StaticResource CardCaption}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </ContentView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </ContentPage>
    </FlyoutPage.Flyout>
</FlyoutPage>