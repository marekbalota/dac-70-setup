<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup x:TypeArguments="x:Boolean"
               xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:local="clr-namespace:DAC70Setup.BL.Controls.Confirmation"
               xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
               x:Class="DAC70Setup.BL.Controls.Confirmation.ConfirmationPopup"
               x:DataType="local:ConfirmationPopupViewModel">

    <VerticalStackLayout Spacing="16">
        <Label Text="{Binding Title.Localized}" Style="{StaticResource PopupTitle}" />

        <Label Text="{Binding Message.Localized}" Style="{StaticResource CardCaption}" />

        <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
            <Button Text="{localization:Translate Cancel}" Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButton}" StyleClass="DialogButton" />

            <Button Text="{Binding ConfirmText.Localized}" Command="{Binding ConfirmCommand}"
                    Style="{StaticResource DestructiveButton}" StyleClass="DialogButton" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</toolkit:Popup>
