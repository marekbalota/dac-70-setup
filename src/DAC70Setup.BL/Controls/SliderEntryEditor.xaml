<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DAC70Setup.BL.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DAC70Setup.BL.Controls.SliderEntryEditor"
             x:Name="Root">

    <ContentView.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
    </ContentView.Resources>

    <Border Style="{StaticResource Card}" Padding="14,12">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2" BindingContext="{x:Reference Root}" x:DataType="controls:SliderEntryEditor">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{Binding Name}" Style="{StaticResource RowLabel}"
                       IsVisible="{Binding Name, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

                <Entry x:Name="ValueEntry" Grid.Column="1" WidthRequest="64" HorizontalTextAlignment="Center"
                       Keyboard="Numeric" Background="Transparent" Completed="OnValueEntryCompleted" />
            </Grid>

            <Slider Grid.Row="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" />

            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0" Text="{Binding Minimum}" Style="{StaticResource Timestamp}" FontSize="11" />
                <Label Grid.Column="2" Text="{Binding Maximum}" Style="{StaticResource Timestamp}" FontSize="11" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
