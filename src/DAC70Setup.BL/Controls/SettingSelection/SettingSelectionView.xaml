<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:selection="clr-namespace:DAC70Setup.BL.Controls.SettingSelection"
             xmlns:fontAwesome="clr-namespace:DAC70Setup.BL.Resources"
             xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DAC70Setup.BL.Controls.SettingSelection.SettingSelectionView"
             x:Name="Root">

    <ContentView.Resources>
        <x:Double x:Key="WideSelectionBarWidth">600</x:Double>
        <toolkit:CompareConverter x:Key="IsNarrowSelectionBarConverter" ComparisonOperator="Smaller"
                                  ComparingValue="{StaticResource WideSelectionBarWidth}" />
    </ContentView.Resources>

    <Grid x:DataType="selection:SettingSelectionViewModel" RowDefinitions="*,Auto"
          BindingContext="{Binding Selection, Source={x:Reference Root}, x:DataType=selection:SettingSelectionView}">
        <CollectionView Grid.Row="0" ItemsSource="{Binding Groups}" SelectionMode="None" IsGrouped="True" Margin="0,4,0,0">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="selection:SettingRowGroup">
                    <VerticalStackLayout>
                        <Label Text="{Binding Panel}" Style="{StaticResource GroupHeader}" />
                        <BoxView Style="{StaticResource RowDivider}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="selection:SettingRowItem">
                    <Grid RowDefinitions="Auto,1"
                          Background="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}" />
                            </DataTrigger>
                        </Grid.Triggers>

                        <Grid Grid.Row="0" ColumnDefinitions="46,*" MinimumHeightRequest="48">
                            <ContentView Grid.Column="0" Background="Transparent">
                                <ContentView.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}"
                                            Command="{Binding Selection.ToggleIncludedCommand, Source={x:Reference Root}, x:DataType=selection:SettingSelectionView}" />
                                </ContentView.GestureRecognizers>

                                <Border WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 4" StrokeThickness="1.5"
                                        HorizontalOptions="Center" VerticalOptions="Center" Background="Transparent"
                                        Stroke="{AppThemeBinding Light={StaticResource OnSurfaceMutedLight}, Dark={StaticResource OnSurfaceMutedDark}}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsIncluded}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                            <Setter Property="Stroke"
                                                    Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Label Text="{x:Static fontAwesome:AwesomeSolidIconFont.Check}" FontFamily="FA-S" FontSize="11"
                                           IsVisible="{Binding IsIncluded}" HorizontalOptions="Center" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                                </Border>
                            </ContentView>

                            <Grid x:Name="RowContent" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="11" Padding="0,11,15,11"
                                  Background="Transparent">
                                <Grid.Behaviors>
                                    <toolkit:TouchBehavior LongPressDuration="500"
                                            Command="{Binding Selection.PressCommand, Source={x:Reference Root}, x:DataType=selection:SettingSelectionView}"
                                            CommandParameter="{Binding BindingContext, Source={x:Reference RowContent}, x:DataType=Grid}"
                                            LongPressCommand="{Binding Selection.LongPressCommand, Source={x:Reference Root}, x:DataType=selection:SettingSelectionView}"
                                            LongPressCommandParameter="{Binding BindingContext, Source={x:Reference RowContent}, x:DataType=Grid}" />
                                </Grid.Behaviors>

                                <Label Grid.Column="0" Text="{Binding Definition.Name}" Style="{StaticResource RowLabel}" />

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                    <Label Text="{Binding ConfigurationValue.DisplayValueText}" IsVisible="{Binding IsIncluded}"
                                           Style="{StaticResource ValueText}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Comparison}" Value="{x:Static selection:SettingComparison.Match}">
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Comparison}" Value="{x:Static selection:SettingComparison.Differs}">
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Label Style="{StaticResource ValueText}" FontFamily="PlexMono" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceMutedLight}, Dark={StaticResource OnSurfaceMutedDark}}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static fontAwesome:AwesomeSolidIconFont.Download}" FontFamily="FA-S" FontSize="11" />
                                                <Span Text=" " />
                                                <Span Text="{Binding DeviceText.Localized}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Comparison}" Value="{x:Static selection:SettingComparison.Match}">
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Comparison}" Value="{x:Static selection:SettingComparison.Differs}">
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>

                        <BoxView Grid.Row="1" Style="{StaticResource RowDivider}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsSelectionMode}"
                             Background="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}">
            <BoxView Style="{StaticResource RowDivider}" />

            <Grid x:Name="SelectionBar" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto" RowSpacing="0" Padding="6,6,12,6">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="WidthStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Narrow">
                            <VisualState.StateTriggers>
                                <StateTrigger
                                        IsActive="{Binding Width, Source={x:Reference SelectionBar}, x:DataType=Grid, Converter={StaticResource IsNarrowSelectionBarConverter}}" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="RowSpacing" Value="6" />
                                <Setter Property="Padding" Value="6,6,12,10" />
                                <Setter TargetName="SelectAllButton" Property="Grid.Column" Value="3" />
                                <Setter TargetName="ActionButtons" Property="Grid.Row" Value="1" />
                                <Setter TargetName="ActionButtons" Property="Grid.Column" Value="0" />
                                <Setter TargetName="ActionButtons" Property="Grid.ColumnSpan" Value="4" />
                                <Setter TargetName="ActionButtons" Property="Grid.ColumnDefinitions" Value="*,*" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                    <Button Text="{x:Static fontAwesome:AwesomeSolidIconFont.Xmark}" Command="{Binding ClearSelectionCommand}"
                            FontFamily="FA-S" FontSize="15" Padding="0" MinimumWidthRequest="36" MinimumHeightRequest="36"
                            Background="Transparent" BorderWidth="0" VerticalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />

                    <Label Text="{localization:TranslateBinding SelectedCount, TranslateFormat=SelectedSettingsCount}"
                           Style="{StaticResource RowLabel}" FontFamily="PlexSansSemiBold" FontSize="14" Margin="2,0,6,0" />
                </HorizontalStackLayout>

                <Button x:Name="SelectAllButton" Grid.Row="0" Grid.Column="1"
                        Text="{localization:Translate SelectAllSettings}" Command="{Binding SelectAllCommand}"
                        FontFamily="PlexSansSemiBold" FontSize="13" Padding="6,0" MinimumHeightRequest="36"
                        Background="Transparent" BorderWidth="0" VerticalOptions="Center"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />

                <Grid x:Name="ActionButtons" Grid.Row="0" Grid.Column="3" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" Margin="6,0,0,0">
                    <Button Grid.Column="0" Text="{localization:Translate UseDeviceValues}" Command="{Binding UseDeviceValuesCommand}"
                            Style="{StaticResource SecondaryButton}" FontSize="13" Padding="12,0" CornerRadius="8"
                            MinimumHeightRequest="36" ContentLayout="Left,6">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FA-S" Size="12" Glyph="{x:Static fontAwesome:AwesomeSolidIconFont.Download}"
                                             Color="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                        </Button.ImageSource>
                    </Button>

                    <Button Grid.Column="1" Text="{localization:Translate SendSelectedToDevice}" Command="{Binding SendSelectedCommand}"
                            Style="{StaticResource PrimaryButton}" FontSize="13" Padding="12,0" CornerRadius="8"
                            MinimumHeightRequest="36" ContentLayout="Left,6">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="FA-S" Size="12" Glyph="{x:Static fontAwesome:AwesomeSolidIconFont.ArrowUpFromBracket}"
                                             Color="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                        </Button.ImageSource>
                    </Button>
                </Grid>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentView>
