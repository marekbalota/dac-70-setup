<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DAC70Setup.BL.Controls"
             xmlns:fontAwesome="clr-namespace:DAC70Setup.BL.Resources"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DAC70Setup.BL.Controls.PageTitleView"
             x:Name="Root">

    <HorizontalStackLayout BindingContext="{x:Reference Root}" x:DataType="controls:PageTitleView" Spacing="10"
                           Margin="{OnPlatform Default=0, WinUI='10,0,0,0'}" VerticalOptions="Center">
        <Label Text="{x:Static fontAwesome:AwesomeSolidIconFont.Sliders}" Style="{StaticResource PageTitle}"
               FontFamily="FA-S" FontSize="{OnPlatform Default=16, WinUI=18}" VerticalOptions="Center"
               IsVisible="{Binding ConfigurationName, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />

        <Label Text="{Binding ConfigurationName}" Style="{StaticResource PageTitle}" FontSize="{OnPlatform Default=20, WinUI=24}"
               LineBreakMode="TailTruncation" VerticalOptions="Center"
               IsVisible="{Binding ConfigurationName, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />

        <Label Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="{OnPlatform Default=20, WinUI=24}"
               LineBreakMode="TailTruncation" VerticalOptions="Center"
               IsVisible="{Binding ConfigurationName, Converter={toolkit:IsStringNullOrEmptyConverter}}" />
    </HorizontalStackLayout>
</ContentView>
