<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DAC70Setup.BL.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DAC70Setup.BL.Controls.ChoiceCard">

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroupList>
            <VisualStateGroup Name="CommonStates">
                <VisualState Name="Normal" />
                <VisualState Name="Disabled">
                    <VisualState.Setters>
                        <Setter Property="Opacity" Value="0.5" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateGroupList>
    </VisualStateManager.VisualStateGroups>

    <ContentView.ControlTemplate>
        <ControlTemplate x:DataType="controls:ChoiceCard">
            <Border Padding="12" StrokeShape="RoundRectangle 12" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                    Background="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{TemplateBinding Command}" />
                </Border.GestureRecognizers>

                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{TemplateBinding IsChosen}" Value="True">
                        <Setter Property="StrokeThickness" Value="2" />
                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="Background"
                                Value="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}" />
                    </DataTrigger>
                </Border.Triggers>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" StrokeThickness="1.5"
                            VerticalOptions="Start" Margin="0,2,0,0" Background="Transparent"
                            Stroke="{AppThemeBinding Light={StaticResource OnSurfaceMutedLight}, Dark={StaticResource OnSurfaceMutedDark}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{TemplateBinding IsChosen}" Value="True">
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Ellipse WidthRequest="8" HeightRequest="8" IsVisible="{TemplateBinding IsChosen}"
                                 HorizontalOptions="Center" VerticalOptions="Center"
                                 Fill="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{TemplateBinding Title}" Style="{StaticResource RowLabel}" />
                        <Label Text="{TemplateBinding Detail}" Style="{StaticResource CardCaption}" FontSize="12"
                               IsVisible="{TemplateBinding Detail, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />

                        <ContentPresenter IsVisible="{TemplateBinding IsChosen}">
                            <ContentPresenter.Triggers>
                                <DataTrigger TargetType="ContentPresenter" Binding="{TemplateBinding Content}" Value="{x:Null}">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </ContentPresenter.Triggers>
                        </ContentPresenter>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
