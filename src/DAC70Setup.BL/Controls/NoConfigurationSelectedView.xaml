<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fontAwesome="clr-namespace:DAC70Setup.BL.Resources"
             xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             xmlns:controls="clr-namespace:DAC70Setup.BL.Controls"
             x:Class="DAC70Setup.BL.Controls.NoConfigurationSelectedView"
             x:Name="Root">

    <VerticalStackLayout BindingContext="{x:Reference Root}" x:DataType="controls:NoConfigurationSelectedView"
                         HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="10">
        <Label Text="{x:Static fontAwesome:AwesomeSolidIconFont.Toolbox}" FontFamily="FA-S" FontSize="34" HorizontalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceMutedLight}, Dark={StaticResource OnSurfaceMutedDark}}" />

        <Label Text="{localization:Translate NoConfigurationSelected}" Style="{StaticResource EmptyStateTitle}" />

        <Button Text="{localization:Translate GoToConfigurations}" Command="{Binding GoToConfigurationsCommand}"
                Style="{StaticResource PrimaryButton}" />
    </VerticalStackLayout>
</ContentView>
