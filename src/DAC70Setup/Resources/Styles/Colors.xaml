    <Color x:Key="OutlineDark">#2A323D</Color>

    <Color x:Key="SuccessLight">#12805C</Color>
    <Color x:Key="SuccessDark">#3DD68C</Color>

    <Color x:Key="ErrorLight">#C0332F</Color>
    <Color x:Key="ErrorDark">#FF6B63</Color>

    <Color x:Key="WarningLight">#9A5B00</Color>
    <Color x:Key="WarningDark">#E3A44A</Color>

