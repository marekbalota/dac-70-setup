<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="BackgroundLight">#F5F6F9</Color>
    <Color x:Key="BackgroundDark">#0E1116</Color>

    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#171B22</Color>

    <Color x:Key="SurfaceRaisedLight">#EEF1F6</Color>
    <Color x:Key="SurfaceRaisedDark">#1E242D</Color>

    <Color x:Key="PrimaryLight">#2E5BFF</Color>
    <Color x:Key="PrimaryDark">#7A9BFF</Color>

    <Color x:Key="PrimaryContainerLight">#E3EAFF</Color>
