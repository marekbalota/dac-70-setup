<?xml version="1.0" encoding="utf-8" ?>
<Window xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        x:Class="DAC70Setup.MainWindow">

    <Window.TitleBar>
        <TitleBar BackgroundColor="{AppThemeBinding Light={StaticResource HeaderLight}, Dark={StaticResource HeaderDark}}"
                  ForegroundColor="{AppThemeBinding Light={StaticResource OnHeaderLight}, Dark={StaticResource OnHeaderDark}}" />
    </Window.TitleBar>

</Window>
